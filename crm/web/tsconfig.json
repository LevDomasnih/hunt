{
  // The Mini App and the site (built by scripts/build-web.mjs). Loose for now: the code came from plain JS;
  // tighten per module (noImplicitAny, then strict) as modules get real types.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["./**/*.ts"]
}
